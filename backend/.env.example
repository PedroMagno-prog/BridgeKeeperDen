# Application
APP_NAME="BridgeKeeper Den"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# API
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Auth / JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─────────────────────────────────────────────────────────────────────────────
# Configuração de banco de dados
#
# OPÇÃO A — Desenvolvimento local (padrão)
#   Deixe DATABASE_URL comentado/ausente. A URL será montada automaticamente
#   a partir das variáveis POSTGRES_* abaixo.
#
# OPÇÃO B — Nuvem (Neon, Supabase, Render...)
#   Defina DATABASE_URL com a string completa fornecida pelo provedor.
#   O prefixo será sanitizado automaticamente para postgresql+asyncpg://.
#   Exemplo:
#   DATABASE_URL=postgres://user:senha@host/db?sslmode=require
# ─────────────────────────────────────────────────────────────────────────────

# OPÇÃO A: variáveis individuais (desenvolvimento local)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=coti
POSTGRES_DB=bridgekeeper

# OPÇÃO B: URL completa (descomente para usar em nuvem)
# DATABASE_URL=postgres://user:senha@host.neon.tech/bridgekeeper?sslmode=require
